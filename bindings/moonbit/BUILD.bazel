load("@rules_shell//shell:sh_test.bzl", "sh_test")

package(default_visibility = ["//visibility:public"])

# Only tracked sources are staged into writable Bazel test directories; never
# build a second Rust engine with Cargo from the MoonBit test runner.
filegroup(
    name = "sdk_sources",
    srcs = glob([
        "*.mbt",
        "tests/**/*.mbt",
        "tests/**/moon.pkg",
        "tests/**/moon.mod",
        "tests/**/moon.work",
        "examples/*.mbt.in",
        "tools/*.py",
        "tools/tests/*.py",
    ]) + [
        "moon.mod",
        "moon.pkg",
        "public_api_surface.txt",
    ],
)

[
    sh_test(
        name = "hawdb_moonbit_%s_test" % mode,
        size = "large",
        timeout = "long",
        srcs = ["tools/bazel_native_test.sh"],
        args = [
            mode,
            "$(rootpath //bindings/moonbit/native:hawdb_moonbit_static)",
        ],
        data = [
            ":sdk_sources",
            "//bindings/moonbit/native:hawdb_moonbit_static",
        ],
        target_compatible_with = select({
            "@platforms//os:windows": ["@platforms//:incompatible"],
            "//conditions:default": [],
        }),
    )
    for mode in ["conformance", "consumer"]
]

test_suite(
    name = "hawdb_moonbit_tests",
    tests = [
        ":hawdb_moonbit_conformance_test",
        ":hawdb_moonbit_consumer_test",
        "//bindings/moonbit/native:hawdb_moonbit_rust_tests",
    ],
)
